+		return -EIO;
+
 	memset(&cmd, 0, sizeof(cmd));
+	if (request_len < 0 || (request_len && !buf) ||
+	    (response_len && (*response_len < 0 || (*response_len && !buf))))
+		return -EINVAL;
 
 	if (response_len) {
 		len = max(request_len, *response_len);
 	} else {
 		len = request_len;
 	}
+	if (len > INT_MAX - sizeof(struct isp_cmd_hdr))
+		return -EOVERFLOW;
